{
  "name": "latexbookbank",
  "version": "0.0.0",
  "private": true,
  "description": "Biblioteca técnica, IDE LaTeX editorial e banco de questões estruturado",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "setup": "bun scripts/setup.mjs",
    "dev": "bun run --filter @latexbookbank/web dev",
    "build": "bun run --filter @latexbookbank/web build",
    "start": "bun run --filter @latexbookbank/web start",
    "lint": "bun run --filter \"*\" lint",
    "typecheck": "bun run --filter \"*\" typecheck",
    "test": "bun run --filter \"*\" test",
    "format": "bunx prettier --write .",
    "format:check": "bunx prettier --check .",
    "db:migrate": "bun run --filter @latexbookbank/web db:migrate",
    "db:seed": "bun run --filter @latexbookbank/web db:seed",
    "db:reset": "bun run --filter @latexbookbank/web db:reset",
    "db:studio": "bun run --filter @latexbookbank/web db:studio",
    "db:import-latex": "bun run --filter @latexbookbank/web db:import-latex"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  },
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "trustedDependencies": [
    "@prisma/engines",
    "prisma"
  ]
}
